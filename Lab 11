class CartProvider extends ChangeNotifier {
  final Map<String, Product> _items = {};

  List<Product> get items => _items.values.toList();
  int get count => _items.length;
  double get total =>
      _items.values.fold(0.0, (sum, p) => sum + p.priceValue);

  bool contains(String id) => _items.containsKey(id);

  void toggle(Product p) {
    if (_items.remove(p.id) == null) _items[p.id] = p;
    notifyListeners();
  }

  void remove(String id) {
    _items.remove(id);
    notifyListeners();
  }

  void clear() {
    _items.clear();
    notifyListeners();
  }
}

