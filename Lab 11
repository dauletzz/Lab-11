  @override
  State<NotesTab> createState() => _NotesTabState();
}

class _NotesTabState extends State<NotesTab> {
  final TextEditingController _noteController = TextEditingController();

  @override
  void dispose() {
    _noteController.dispose();
    super.dispose();
  }

  Future<void> _handleAdd() async {
    final text = _noteController.text;
    if (text.trim().isEmpty) return;
    _noteController.clear();
    await addNoteItem(text);
  }

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;

    return Scaffold(
      appBar: buildAppBar(
        context,
        title: const Text('Notes Vault', style: _screenTitle),
      ),
      body: Padding(
        padding: const EdgeInsets.fromLTRB(16, 4, 16, 16),
        child: Column(
          children: [
            Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _noteController,
                    decoration: InputDecoration(
                      hintText: 'Add a note (saved as JSON)...',
                      filled: true,
                      fillColor: cardColor(context),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(18),
                        borderSide: BorderSide.none,
                      ),
                    ),
                    onSubmitted: (_) => _handleAdd(),
                  ),
                ),
                const SizedBox(width: 10),
                FilledButton.icon(
                  style: FilledButton.styleFrom(
                    minimumSize: const Size(0, 52),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(18),
                    ),
                  ),
                  onPressed: _handleAdd,
                  icon: const Icon(Icons.add),
                  label: const Text('Add'),
                ),
              ],
            ),
            const SizedBox(height: 14),
            Expanded(
              child: ValueListenableBuilder<List<NoteItem>>(
                valueListenable: notesNotifier,
                builder: (context, notes, _) {
                  if (notes.isEmpty) {
                    return Center(
                      child: Text(
                        'No notes yet.\nAdd one above to test JSON persistence.',
                        textAlign: TextAlign.center,
                        style: TextStyle(color: scheme.onSurfaceVariant),
                      ),
                    );
                  }

                  return ListView.separated(
                    itemCount: notes.length,
                    separatorBuilder: (_, __) => const SizedBox(height: 10),
                    itemBuilder: (context, i) {
                      final note = notes[i];
                      return Container(
                        decoration: BoxDecoration(
                          color: cardColor(context),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: ListTile(
                          leading: Checkbox(
                            value: note.isCompleted,
                            onChanged: (v) => toggleNoteItem(note.id, v),
                          ),
                          title: Text(
                            note.title,
                            style: TextStyle(
                              fontWeight: FontWeight.w700,
                              decoration: note.isCompleted
                                  ? TextDecoration.lineThrough
                                  : null,
                            ),
                          ),
                          subtitle: Text(note.dateText),
                          trailing: IconButton(
                            tooltip: 'Delete note',
                            icon: const Icon(Icons.delete_outline,
                                color: Colors.red),
                            onPressed: () => deleteNoteItem(note.id),
                          ),
                        ),
                      );
                    },
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}

