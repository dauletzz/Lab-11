const String _kDarkModeKey = 'app_theme_dark_mode';
const String _kUserDisplayNameKey = 'user_display_name';
const String _kNotesJsonKey = 'lw11_notes_json';

late SharedPreferences _prefs;

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();

  _prefs = await SharedPreferences.getInstance();

  final bool isDark = _prefs.getBool(_kDarkModeKey) ?? false;
  themeMode.value = isDark ? ThemeMode.dark : ThemeMode.light;

  final String? savedName = _prefs.getString(_kUserDisplayNameKey);
  userDisplayName.value =
      (savedName != null && savedName.trim().isNotEmpty)
          ? savedName.trim()
          : 'Guest User';

  notesNotifier.value = _loadNotesFromPrefs(_prefs);

  runApp(
    ChangeNotifierProvider(
      create: (_) => CartProvider(),
      child: const MyApp(),
    ),
  );
}

