class NoteItem {
  const NoteItem({
    required this.id,
    required this.title,
    required this.dateText,
    this.isCompleted = false,
  });

  final String id;
  final String title;
  final String dateText;
  final bool isCompleted;

  NoteItem copyWith({
    String? id,
    String? title,
    String? dateText,
    bool? isCompleted,
  }) {
    return NoteItem(
      id: id ?? this.id,
      title: title ?? this.title,
      dateText: dateText ?? this.dateText,
      isCompleted: isCompleted ?? this.isCompleted,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'title': title,
      'dateText': dateText,
      'isCompleted': isCompleted,
    };
  }

  factory NoteItem.fromJson(Map<String, dynamic> json) {
    return NoteItem(
      id: json['id'] as String? ?? '',
      title: json['title'] as String? ?? '',
      dateText: json['dateText'] as String? ?? '',
      isCompleted: json['isCompleted'] as bool? ?? false,
    );
  }
}

List<NoteItem> _loadNotesFromPrefs(SharedPreferences prefs) {
  final String? raw = prefs.getString(_kNotesJsonKey);
  if (raw == null || raw.isEmpty) return [];
  try {
    final List<dynamic> decoded = jsonDecode(raw) as List<dynamic>;
    return decoded
        .map((e) => NoteItem.fromJson(e as Map<String, dynamic>))
        .toList();
  } catch (_) {
    return [];
  }
}

Future<void> _saveNotesToPrefs(List<NoteItem> notes) async {
  final String encoded = jsonEncode(notes.map((n) => n.toJson()).toList());
  await _prefs.setString(_kNotesJsonKey, encoded);
}

final ValueNotifier<List<NoteItem>> notesNotifier =
    ValueNotifier<List<NoteItem>>([]);
final ValueNotifier<String> userDisplayName =
    ValueNotifier<String>('Guest User');

Future<void> setDarkModePersisted(bool enabled) async {
  themeMode.value = enabled ? ThemeMode.dark : ThemeMode.light;
  await _prefs.setBool(_kDarkModeKey, enabled);
}

Future<void> saveUserDisplayName(String rawName) async {
  final trimmed = rawName.trim();
  final resolved = trimmed.isEmpty ? 'Guest User' : trimmed;
  userDisplayName.value = resolved;
  await _prefs.setString(_kUserDisplayNameKey, resolved);
}

Future<void> addNoteItem(String title) async {
  final trimmed = title.trim();
  if (trimmed.isEmpty) return;

  final now = DateTime.now();
  final dateText =
      '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')} '
      '${now.hour.toString().padLeft(2, '0')}:${now.minute.toString().padLeft(2, '0')}';

  final newNote = NoteItem(
    id: DateTime.now().microsecondsSinceEpoch.toString(),
    title: trimmed,
    dateText: dateText,
    isCompleted: false,
  );

  final updated = [newNote, ...notesNotifier.value];
  notesNotifier.value = updated;
  await _saveNotesToPrefs(updated);
}

Future<void> toggleNoteItem(String id, bool? checked) async {
  final updated = notesNotifier.value.map((n) {
    if (n.id != id) return n;
    return n.copyWith(isCompleted: checked ?? !n.isCompleted);
  }).toList();
  notesNotifier.value = updated;
  await _saveNotesToPrefs(updated);
}

Future<void> deleteNoteItem(String id) async {
  final updated = notesNotifier.value.where((n) => n.id != id).toList();
  notesNotifier.value = updated;
  await _saveNotesToPrefs(updated);
}

