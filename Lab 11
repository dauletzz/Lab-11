class FeedTab extends StatefulWidget {
  const FeedTab({super.key});

  @override
  State<FeedTab> createState() => _FeedTabState();
}

class _FeedTabState extends State<FeedTab> {
  List<Product> _items = List<Product>.of(products);
  bool _isGrid = false;

  Future<void> _onRefresh() async {
    await Future.delayed(const Duration(milliseconds: 1500));
    if (!mounted) return;
    final fresh = generateProduct();
    productIndex[fresh.id] = fresh;
    setState(() => _items.insert(0, fresh));
  }

  void _onDismissed(Product product) {
    final index = _items.indexWhere((e) => e.id == product.id);
    if (index == -1) return;

    setState(() => _items.removeAt(index));

    final messenger = ScaffoldMessenger.of(context);
    messenger
      ..clearSnackBars()
      ..showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(16),
          ),
          duration: const Duration(seconds: 4),
          content: Text('"${product.title}" removed'),
          action: SnackBarAction(
            label: 'UNDO',
            onPressed: () {
              final at = index > _items.length ? _items.length : index;
              setState(() => _items.insert(at, product));
            },
          ),
        ),
      );
  }

  void _resetCatalog() {
    ScaffoldMessenger.of(context).clearSnackBars();
    setState(() => _items = List<Product>.of(products));
  }

  Widget _dismissible({
    required Product product,
    required Widget child,
    BorderRadius borderRadius = BorderRadius.zero,
  }) {
    return Dismissible(
      key: ValueKey(product.id),
      direction: DismissDirection.endToStart,
      onDismissed: (_) => _onDismissed(product),
      background: Container(
        decoration: BoxDecoration(
          color: Colors.red,
          borderRadius: borderRadius,
        ),
        alignment: Alignment.centerRight,
        padding: const EdgeInsets.only(right: 24),
        child: const Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              'Delete',
              style: TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.w700,
              ),
            ),
            SizedBox(width: 8),
            Icon(Icons.delete, color: Colors.white, size: 28),
          ],
        ),
      ),
      child: child,
    );
  }

  Widget _buildList() {
    return ListView.separated(
      key: const PageStorageKey('feed-list'),
      physics: const AlwaysScrollableScrollPhysics(),
      itemCount: _items.length,
      separatorBuilder: (_, __) => Divider(
        height: 1,
        thickness: 0.5,
        indent: 84,
        color: Theme.of(context).colorScheme.outlineVariant,
      ),
      itemBuilder: (context, i) {
        final p = _items[i];
        return _dismissible(
          product: p,
          child: ProductListRow(
            product: p,
            onTap: () => openDetail(context, p),
          ),
        );
      },
    );
  }

  Widget _buildGrid() {
    return GridView.builder(
      key: const PageStorageKey('feed-grid'),
      physics: const AlwaysScrollableScrollPhysics(),
      padding: const EdgeInsets.fromLTRB(16, 4, 16, 16),
      itemCount: _items.length,
      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        mainAxisSpacing: 14,
        crossAxisSpacing: 14,
        childAspectRatio: 0.72,
      ),
      itemBuilder: (context, i) {
        final p = _items[i];
        return _dismissible(
          product: p,
          borderRadius: BorderRadius.circular(24),
          child: ProductGridCard(
            product: p,
            onTap: () => openDetail(context, p),
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;

    return Scaffold(
      appBar: buildAppBar(
        context,
        toolbarHeight: 72,
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text('Smart Catalog', style: _screenTitle),
            const SizedBox(height: 2),
            ValueListenableBuilder<String>(
              valueListenable: userDisplayName,
              builder: (context, name, _) => Text(
                '$name · ${_items.length} products · pull down to refresh',
                style: TextStyle(
                  fontSize: 12,
                  fontWeight: FontWeight.w500,
                  color: scheme.onSurfaceVariant,
                ),
              ),
            ),
          ],
        ),
        actions: [
          const CartBadgeButton(),
          ViewToggle(
            isGrid: _isGrid,
            onChanged: (grid) => setState(() => _isGrid = grid),
          ),
          const SizedBox(width: 12),
        ],
      ),
      body: _items.isEmpty
          ? EmptyCatalog(onReset: _resetCatalog)
          : RefreshIndicator(
              onRefresh: _onRefresh,
              child: _isGrid ? _buildGrid() : _buildList(),
            ),
    );
  }
}

